# Local machine configuration — contains absolute SDK paths, never portable.
local.properties

# Gradle and build output.
.gradle/
build/
app/build/
.kotlin/
.cxx/

# Signing material. A keystore must never reach a repository: anyone holding it
# can publish an update to the app under its identity.
*.jks
*.keystore
keystore.properties
*.p12

# Build artefacts.
*.apk
*.aab
*.aar

# Verification logs written by the scripts in scripts/.
*.log

# Editors.
.idea/
*.iml
.DS_Store

# Launcher icons generated per build by scripts/GenerateIcons.java from the
# project's configured icon. They are build output, not source — committing them
# would bake one customer's branding into the template.
app/src/main/res/mipmap-mdpi/
app/src/main/res/mipmap-hdpi/
app/src/main/res/mipmap-xhdpi/
app/src/main/res/mipmap-xxhdpi/
app/src/main/res/mipmap-xxxhdpi/
app/src/main/res/drawable/ic_launcher_foreground.png
app/icon-source.png
